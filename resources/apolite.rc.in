// ApoLite - version resource template. Configured by CMake into apolite.rc.
// Copyright (c) 2026 Joel Mandell. MIT licensed.
//
// The APO registration schema has no patch field, so this is where the patch
// digit becomes visible: Windows shows it in the file properties dialog.
#include <winver.h>

#define APOLITE_FILEVERSION @APOLITE_VERSION_MAJOR@, @APOLITE_VERSION_MINOR@, @APOLITE_VERSION_PATCH@, 0
#define APOLITE_VERSION_STR "@APOLITE_VERSION_STRING@\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APOLITE_FILEVERSION
 PRODUCTVERSION APOLITE_FILEVERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @APOLITE_FILETYPE@
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Joel Mandell\0"
            VALUE "FileDescription", "@APOLITE_FILEDESCRIPTION@\0"
            VALUE "FileVersion", APOLITE_VERSION_STR
            VALUE "InternalName", "@APOLITE_INTERNALNAME@\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Joel Mandell. MIT licensed.\0"
            VALUE "OriginalFilename", "@APOLITE_ORIGINALFILENAME@\0"
            VALUE "ProductName", "ApoLite\0"
            VALUE "ProductVersion", APOLITE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
